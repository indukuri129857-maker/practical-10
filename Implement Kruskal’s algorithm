
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, weight;
};

bool compare(Edge a, Edge b) {
    return a.weight < b.weight;
}

int parent[100], rnk[100];

int find(int x) {
    if (parent[x] != x)
        parent[x] = find(parent[x]);
    return parent[x];
}

void unite(int x, int y) {
    int a = find(x);
    int b = find(y);

    if (a == b)
        return;

    if (rnk[a] < rnk[b])
        parent[a] = b;
    else if (rnk[a] > rnk[b])
        parent[b] = a;
    else {
        parent[b] = a;
        rnk[a]++;
    }
}

int main() {
    int n, m;
    cout << "Enter number of vertices and edges: ";
    cin >> n >> m;

    vector<Edge> edges(m);

    cout << "Enter edges (u v weight):\n";
    for (int i = 0; i < m; i++) {
        cin >> edges[i].u >> edges[i].v
            >> edges[i].weight;
    }

    sort(edges.begin(), edges.end(), compare);

    for (int i = 0; i < n; i++) {
        parent[i] = i;
        rnk[i] = 0;
    }

    int totalWeight = 0, count = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    for (Edge e : edges) {
        if (find(e.u) != find(e.v)) {
            unite(e.u, e.v);
            cout << e.u << " - " << e.v
                 << " : " << e.weight << '\n';

            totalWeight += e.weight;
            count++;

            if (count == n - 1)
                break;
        }
    }

    if (count != n - 1)
        cout << "Graph is disconnected; MST does not exist.\n";
    else
        cout << "Total weight of MST: "
             << totalWeight << '\n';

    return 0;
}
